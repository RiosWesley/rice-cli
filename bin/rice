#!/usr/bin/env python3
"""
rice - Declarative Rice & Reproducibility Orchestrator
Automates multi-profile Hyprland ricing, declarative dotfiles/manifests via chezmoi,
BTRFS root disaster recovery via Snapper, and sandboxed foreign rice installation.
"""

import sys
import os
import subprocess
import argparse
import json
import shutil
from pathlib import Path

HOME = Path.home()
HYPR_DIR = HOME / ".config" / "hypr"
PROFILES_DIR = HYPR_DIR / "profiles"
SHARED_DIR = HYPR_DIR / "shared"
ACTIVE_LINK = HYPR_DIR / "hyprland.lua"
CHEZMOI_DIR = HOME / ".local" / "share" / "chezmoi"
MANIFESTS_DIR = CHEZMOI_DIR / "manifests"
STATE_FILE = HOME / ".local" / "share" / "rice" / "state.json"

CHEZMOI_BIN = Path(os.getenv("CHEZMOI_BIN", str(HOME / ".local" / "bin" / "chezmoi")))
if not CHEZMOI_BIN.exists():
    CHEZMOI_BIN = Path("chezmoi")

def ensure_state_dir():
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    if not STATE_FILE.exists():
        initial_state = {
            "last_clean_snapshot": None,
            "profiles": {}
        }
        with open(STATE_FILE, "w") as f:
            json.dump(initial_state, f, indent=2)

def load_state():
    ensure_state_dir()
    try:
        with open(STATE_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return {"last_clean_snapshot": None, "profiles": {}}

def save_state(state):
    ensure_state_dir()
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)

def run_cmd(cmd, capture=True, check=False):
    try:
        res = subprocess.run(
            cmd,
            shell=True,
            text=True,
            capture_output=capture,
            check=check
        )
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except subprocess.CalledProcessError as e:
        return e.returncode, (e.stdout or "").strip(), (e.stderr or "").strip()

def get_active_profile():
    if ACTIVE_LINK.is_symlink():
        target = os.readlink(ACTIVE_LINK)
        parts = Path(target).parts
        if "profiles" in parts:
            idx = parts.index("profiles")
            if idx + 1 < len(parts):
                return parts[idx + 1]
        return Path(target).name
    elif ACTIVE_LINK.exists():
        return "custom/direct"
    return "unknown"

def get_latest_snapshot_id():
    rc, out, _ = run_cmd("snapper -c root list 2>/dev/null")
    if rc == 0:
        lines = [l for l in out.splitlines() if l.strip()]
        for line in reversed(lines):
            parts = [p.strip() for p in line.split("│")]
            if len(parts) > 1 and parts[0].isdigit():
                return int(parts[0])
    return None

def cmd_status(args):
    print("=== Rice Environment Status ===")
    active = get_active_profile()
    print(f"• Active Profile   : \033[1;32m{active}\033[0m")
    
    # Packages count
    rc, pkg_count, _ = run_cmd("pacman -Q 2>/dev/null | wc -l")
    if rc == 0 and pkg_count:
        print(f"• Packages (total) : {pkg_count}")
    
    # Snapper last snapshot
    rc, snap_out, _ = run_cmd("snapper -c root list 2>&1")
    if rc == 0:
        lines = [l for l in snap_out.splitlines() if l.strip()]
        last_snap = lines[-1] if lines else "None"
        print(f"• Snapper Root     : {last_snap}")
    else:
        print(f"• Snapper Root     : Permission required (run setup script if pending)")

    # Chezmoi status
    if CHEZMOI_DIR.exists():
        rc, git_status, _ = run_cmd(f"git -C {CHEZMOI_DIR} status --short")
        rc_log, last_commit, _ = run_cmd(f"git -C {CHEZMOI_DIR} log -1 --oneline")
        print(f"• Chezmoi Commit   : {last_commit if rc_log == 0 else 'None'}")
        if git_status:
            print("• Chezmoi Changes  : \033[1;33mUncommitted changes present\033[0m")
        else:
            print("• Chezmoi Changes  : \033[1;32mClean\033[0m")
    else:
        print(f"• Chezmoi          : Not initialized")

    state = load_state()
    if state.get("last_clean_snapshot"):
        print(f"• Pinned Baseline  : Snapshot #{state['last_clean_snapshot']}")

def cmd_list(args):
    print("=== Available Profiles ===")
    if not PROFILES_DIR.exists():
        print(f"No profiles directory found at {PROFILES_DIR}")
        return
    
    active = get_active_profile()
    profiles = [p.name for p in PROFILES_DIR.iterdir() if p.is_dir() and (p / "hyprland.lua").exists()]
    profiles.sort()
    for p in profiles:
        indicator = "\033[1;32m* (active)\033[0m" if p == active else "  "
        print(f" {indicator} {p}")

def cmd_switch(args):
    target = args.profile
    target_lua = PROFILES_DIR / target / "hyprland.lua"
    if not target_lua.exists():
        print(f"\033[1;31mError:\033[0m Profile '{target}' does not exist at {target_lua}")
        return 1

    rel_target = os.path.relpath(target_lua, HYPR_DIR)
    if ACTIVE_LINK.is_symlink() or ACTIVE_LINK.exists():
        ACTIVE_LINK.unlink()
    ACTIVE_LINK.symlink_to(rel_target)
    print(f"\033[1;32mSuccess:\033[0m Switched active symlink to profile '\033[1m{target}\033[0m'.")
    print("\nNote:")
    print(" • For full daemon/shell reloads: Logout and select the session in your Display Manager.")
    print(" • Or perform a live compositor reload: \033[1mhyprctl reload\033[0m")
    print(" • To exit current Hyprland session: \033[1mhyprctl dispatch exit\033[0m")

def cmd_diff(args):
    chezmoi = str(CHEZMOI_BIN)
    os.system(f"{chezmoi} diff")

def cmd_save(args):
    msg = args.message
    print("1. Updating software manifests...")
    MANIFESTS_DIR.mkdir(parents=True, exist_ok=True)
    run_cmd(f"pacman -Qqe > {MANIFESTS_DIR / 'packages.txt'}")
    run_cmd(f"pacman -Qqem > {MANIFESTS_DIR / 'aur-packages.txt'}")
    run_cmd(f"{{ systemctl --user list-unit-files --state=enabled --no-legend 2>/dev/null | awk '{{print $1}}' || true; systemctl list-unit-files --state=enabled --no-legend 2>/dev/null | awk '{{print $1}}' || true; }} > {MANIFESTS_DIR / 'services.txt'}")
    
    print("2. Syncing dotfiles to chezmoi...")
    chezmoi = str(CHEZMOI_BIN)
    run_cmd(f"{chezmoi} add ~/.config/fish ~/.config/kitty ~/.config/hypr/profiles ~/.config/hypr/shared ~/.config/hypr/custom 2>/dev/null || true")
    
    print("3. Committing to chezmoi repository...")
    run_cmd(f"git -C {CHEZMOI_DIR} add .")
    rc, out, err = run_cmd(f"git -C {CHEZMOI_DIR} commit -m {subprocess.list2cmdline([msg])}")
    if rc == 0:
        print(f"\033[1;32mSaved successfully:\033[0m {out.splitlines()[0] if out else ''}")
    else:
        if "nothing to commit" in out or "nothing to commit" in err:
            print("\033[1;33mNotice:\033[0m No configuration changes to commit.")
        else:
            print(f"\033[1;31mGit error:\033[0m {err or out}")

def cmd_snapshot(args):
    desc = args.description
    print(f"Creating root snapshot: '{desc}'...")
    rc, out, err = run_cmd(f"snapper -c root create -d {subprocess.list2cmdline([desc])}")
    if rc != 0:
        print("\033[1;33mNormal user permission denied, trying with sudo...\033[0m")
        ret = os.system(f"sudo snapper -c root create -d {subprocess.list2cmdline([desc])}")
        if ret == 0:
            print("\033[1;32mSnapshot created successfully via sudo.\033[0m")
        else:
            print(f"\033[1;31mFailed to create snapshot.\033[0m")
            return 1
    else:
        print(f"\033[1;32mSnapshot created successfully.\033[0m")

    snap_id = get_latest_snapshot_id()
    if snap_id:
        state = load_state()
        state["last_clean_snapshot"] = snap_id
        save_state(state)
        print(f"Pinned Snapshot #{snap_id} as current clean baseline.")

def cmd_restore(args):
    print("\033[1;36m[rice restore] Starting complete system & dotfiles rollback...\033[0m")
    state = load_state()
    target_profile = args.profile or "end4"

    # 1. Check if user requested system snapshot rollback
    snap_id = args.snapshot or state.get("last_clean_snapshot")
    if snap_id and not args.no_snapper:
        print(f"• Reverting root filesystem (BTRFS) to Snapshot #{snap_id} via Snapper...")
        rc, out, err = run_cmd(f"sudo snapper -c root undochange {snap_id}..0")
        if rc == 0:
            print(f"  \033[1;32m✓\033[0m Root filesystem changes reverted to Snapshot #{snap_id}.")
        else:
            print(f"  \033[1;33m⚠\033[0m Snapper undochange returned {rc}: {err or out}")

    # 2. Reset SDDM theme to default if modified
    sddm_theme = args.sddm_theme or "breeze"
    if Path("/etc/sddm.conf").exists():
        print(f"• Ensuring SDDM theme is set to '{sddm_theme}'...")
        run_cmd(f"sudo sed -i 's/^Current=.*/Current={sddm_theme}/' /etc/sddm.conf 2>/dev/null || true")

    # 3. Reset working tree if dirty git state in chezmoi
    if CHEZMOI_DIR.exists():
        run_cmd(f"git -C {CHEZMOI_DIR} reset --hard HEAD")

    # 4. Force apply chezmoi to overwrite any modifications made by external rices
    print("• Restoring tracked user dotfiles from chezmoi repository (force overwrite)...")
    chezmoi = str(CHEZMOI_BIN)
    rc, out, err = run_cmd(f"{chezmoi} apply --force")
    if rc != 0:
        print(f"\033[1;31mError during chezmoi apply:\033[0m {err or out}")
    else:
        print("  \033[1;32m✓\033[0m Dotfiles restored successfully.")

    # 5. Ensure hyprland.lua active symlink is restored
    target_lua = PROFILES_DIR / target_profile / "hyprland.lua"
    if target_lua.exists():
        rel_target = os.path.relpath(target_lua, HYPR_DIR)
        if ACTIVE_LINK.is_symlink() or ACTIVE_LINK.exists():
            ACTIVE_LINK.unlink()
        ACTIVE_LINK.symlink_to(rel_target)
        print(f"  \033[1;32m✓\033[0m Active Hyprland entry symlinked to profile '{target_profile}'.")

    # 6. Live reload compositor if running
    print("• Reloading Hyprland...")
    rc, _, _ = run_cmd("hyprctl reload")
    if rc == 0:
        print("  \033[1;32m✓\033[0m Hyprland reloaded.")
    else:
        print("  \033[1;33m⚠\033[0m Hyprland is not currently running or reload failed.")

    print("\n\033[1;32mRollback completed!\033[0m System and desktop state fully restored.")

def cmd_wrap(args):
    profile_name = args.name
    command = args.command
    if not command:
        print("\033[1;31mError:\033[0m No installation command specified. Example: rice wrap --name myrice ./install.sh")
        return 1

    print(f"\033[1;36m=== [rice wrap] Starting Sandboxed Rice Installer for '{profile_name}' ===\033[0m")
    
    # 1. Create automatic baseline snapshot
    desc = f"pre-rice-wrap-{profile_name}"
    print(f"1. Creating pre-installation root snapshot '{desc}'...")
    cmd_snapshot(argparse.Namespace(description=desc))
    snap_id = get_latest_snapshot_id()

    # 2. Prepare profile directory
    target_profile_dir = PROFILES_DIR / profile_name
    target_profile_dir.mkdir(parents=True, exist_ok=True)

    # 3. Execute with filesystem redirection protection
    # We use bwrap (Bubblewrap) if available to sandbox user config destination
    has_bwrap = shutil.which("bwrap") is not None
    print(f"2. Preparing sandbox environment (Bubblewrap: {'Available' if has_bwrap else 'Fallback Mode'})...")

    env = os.environ.copy()
    env["RICE_PROFILE"] = profile_name

    cmd_str = " ".join(command)
    print(f"3. Executing installer: '\033[1m{cmd_str}\033[0m'...")
    
    # If bubblewrap is available, bind-mount target_profile_dir over ~/.config/hypr for the child
    if has_bwrap and not args.no_sandbox:
        bwrap_cmd = [
            "bwrap",
            "--dev-bind", "/", "/",
            "--bind", str(target_profile_dir), str(HYPR_DIR),
            "--setenv", "RICE_PROFILE", profile_name,
            "/bin/bash", "-c", cmd_str
        ]
        ret = subprocess.call(bwrap_cmd)
    else:
        ret = subprocess.call(cmd_str, shell=True, env=env)

    # 4. Post-install validation & integration
    print(f"\n4. Post-installation integration for '{profile_name}'...")
    profile_lua = target_profile_dir / "hyprland.lua"
    if not profile_lua.exists():
        # Look for hyprland.conf or generated entry
        conf_cand = target_profile_dir / "hyprland.conf"
        if conf_cand.exists():
            print("• Converting legacy hyprland.conf into modular Lua profile wrapper...")
            with open(profile_lua, "w") as f:
                f.write(f'-- Profile: {profile_name}\n')
                f.write('require("shared.monitors")\n')
                f.write('require("shared.input")\n')
                f.write('require("shared.env")\n')
                f.write('require("shared.rules")\n')
                f.write(f'hl.exec_cmd("hyprctl reload")\n')

    # 5. Generate session wrapper and desktop entry
    bin_script = HOME / ".local" / "bin" / f"hypr-{profile_name}"
    desktop_entry = HOME / ".local" / "share" / "wayland-sessions" / f"hyprland-{profile_name}.desktop"
    
    with open(bin_script, "w") as f:
        f.write(f"#!/usr/bin/env bash\nexport HYPR_PROFILE=\"{profile_name}\"\nexec start-hyprland -- --config \"{profile_lua}\"\n")
    bin_script.chmod(0o755)

    desktop_entry.parent.mkdir(parents=True, exist_ok=True)
    with open(desktop_entry, "w") as f:
        f.write(f"[Desktop Entry]\nName=Hyprland ({profile_name})\nComment=Hyprland {profile_name} profile\nExec=/usr/local/bin/hypr-{profile_name}\nType=Application\nDesktopNames=Hyprland\nKeywords=tiling;wayland;rice;\n")

    # Record in state
    state = load_state()
    state["profiles"][profile_name] = {
        "snapshot_id": snap_id,
        "entry": str(profile_lua)
    }
    save_state(state)

    print(f"\033[1;32m✓ Profile '{profile_name}' installed and registered!\033[0m")
    print(f" • Session wrapper: {bin_script}")
    print(f" • Desktop session: {desktop_entry}")
    print(f" • To switch right now: \033[1mrice switch {profile_name}\033[0m")
    print(f" • To rollback if anything broke: \033[1mrice restore\033[0m")
    return ret

def main():
    parser = argparse.ArgumentParser(
        prog="rice",
        description="Rice & Reproducibility Orchestrator (Hyprland + Snapper + chezmoi + Sandbox)"
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # status
    p_status = subparsers.add_parser("status", help="Show environment, profiles, chezmoi and snapshot status")
    p_status.set_defaults(func=cmd_status)

    # list
    p_list = subparsers.add_parser("list", help="List available desktop profiles")
    p_list.set_defaults(func=cmd_list)

    # switch
    p_switch = subparsers.add_parser("switch", help="Switch Hyprland active profile")
    p_switch.add_argument("profile", help="Profile name (e.g. end4, vanilla, cyberarch)")
    p_switch.set_defaults(func=cmd_switch)

    # diff
    p_diff = subparsers.add_parser("diff", help="Show diff between live dotfiles and chezmoi")
    p_diff.set_defaults(func=cmd_diff)

    # save
    p_save = subparsers.add_parser("save", help="Dump manifests, add dotfiles and commit changes")
    p_save.add_argument("message", help="Commit message")
    p_save.set_defaults(func=cmd_save)

    # snapshot
    p_snap = subparsers.add_parser("snapshot", help="Create a Snapper root snapshot")
    p_snap.add_argument("description", help="Snapshot description")
    p_snap.set_defaults(func=cmd_snapshot)

    # restore
    p_rest = subparsers.add_parser("restore", help="Complete rollback of system (BTRFS) and user dotfiles (chezmoi)")
    p_rest.add_argument("--profile", default="end4", help="Profile to activate after restore (default: end4)")
    p_rest.add_argument("--snapshot", type=int, help="Specific Snapper snapshot ID to revert")
    p_rest.add_argument("--no-snapper", action="store_true", help="Skip root filesystem rollback")
    p_rest.add_argument("--sddm-theme", default="breeze", help="SDDM theme to restore (default: breeze)")
    p_rest.set_defaults(func=cmd_restore)

    # wrap
    p_wrap = subparsers.add_parser("wrap", help="Run a foreign rice installer in a protected sandbox")
    p_wrap.add_argument("--name", required=True, help="Name for the new profile (e.g. cyberarch, hyprcraft)")
    p_wrap.add_argument("--no-sandbox", action="store_true", help="Disable bubblewrap filesystem redirection")
    p_wrap.add_argument("command", nargs=argparse.REMAINDER, help="Installer command to run (e.g. ./install.sh)")
    p_wrap.set_defaults(func=cmd_wrap)

    args = parser.parse_args()
    return args.func(args)

if __name__ == "__main__":
    sys.exit(main() or 0)
